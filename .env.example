# Local development only. Render assigns PORT at runtime; do not hardcode it in production.
PORT=5000
NODE_ENV=development
# Local MongoDB for development. Production must use a public MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/companyiq
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Dedicated Demo Account Password (development only, used for local credential testing)
DEMO_PASSWORD=
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
# Comma-separated browser origins. Production example: https://your-frontend.example
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Google OAuth 2.0 Credentials
# The GIS sign-in flow verifies ID tokens with GOOGLE_CLIENT_ID only.
# GOOGLE_CLIENT_SECRET and GOOGLE_CALLBACK_URL are unused by the current token flow.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Company Discovery & Data Providers
# OpenCorporates API Token (https://api.opencorporates.com/documentation/API-Reference)
# Optional: if provided, enables authenticated OpenCorporates company entity searches
OPENCORPORATES_API_TOKEN=

# UK Companies House API Key (https://developer-specs.company-information.service.gov.uk/)
# Optional: if provided, enables UK company searches via Companies House Public API
COMPANIES_HOUSE_API_KEY=

# Active providers (comma separated): mca,wikidata,clearbit,opencorporates,companies_house
COMPANY_DATA_PROVIDERS=mca,wikidata,clearbit,opencorporates,companies_house
CACHE_TTL_HOURS=24
PROVIDER_TIMEOUT_MS=4000

